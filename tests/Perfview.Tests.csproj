<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <None Update="Read-TemperatureProbe.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Perfview.csproj" AdditionalProperties="OutputPath=artifacts\tests\app\">
      <ReferenceOutputAssembly Condition="'$(PerfviewAppDirectory)' != ''">false</ReferenceOutputAssembly>
      <BuildReference Condition="'$(PerfviewAppDirectory)' != ''">false</BuildReference>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(PerfviewAppDirectory)' != ''">
    <Reference Include="Perfview">
      <HintPath>$(PerfviewAppDirectory)\Perfview.exe</HintPath>
    </Reference>
    <None Include="$(PerfviewAppDirectory)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
